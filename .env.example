# Database (Neon)
# Example: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=


# Site URL for SEO and Metadata
# Used for metadataBase and OG image paths
# In development, defaults to http://localhost:3000
# In Vercel previews, defaults to the preview URL
NEXT_PUBLIC_SITE_URL=https://example.com